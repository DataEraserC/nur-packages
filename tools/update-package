#!/usr/bin/env bash
# Run passthru.updateScript-based package updates (see helpers/update.nix).
#
# Usage:
#   ./tools/update-package <attr-path> [<attr-path>...]
#   ./tools/update-package --path <group-prefix>
#   ./tools/update-package --own
#   ./tools/update-package --all
set -euo pipefail
cd "$(dirname "$0")/.."

# nix-update's eval step and the nix-shell shebangs of the per-package update
# scripts resolve <nixpkgs> through NIX_PATH; pin it to the flake-locked tree so
# they match what the flake builds instead of drifting with the ambient channel.
export NIX_PATH=nixpkgs=$(nix eval --impure --raw --expr '(builtins.getFlake (toString ./.)).inputs.nixpkgs.outPath')

if [ $# -eq 0 ]; then
	echo "Usage: $0 <attr-path>... | --path <prefix> | --own | --all" >&2
	exit 1
fi

# Packages may consume sibling flake inputs (e.g. opencode2dsh); pass this
# repository's inputs so that they evaluate exactly like `nix build .#...`.
# helpers/update.nix is an upstream file: after a migration to a new
# upstream/master it may no longer accept the argument, so only pass it when
# the runner actually declares it.
INPUT_ARGS=()
if nix-instantiate --eval -E 'builtins.functionArgs (import ./helpers/update.nix)' 2>/dev/null |
	grep -q 'inputs ='; then
	INPUT_ARGS=(--arg inputs '(builtins.getFlake (toString ./.)).inputs')
fi

case "$1" in
--all)
	exec nix-shell helpers/update.nix "${INPUT_ARGS[@]}" --argstr packages ""
	;;
--own)
	# Downstream-maintained packages only; the selection rules live in
	# helpers/own-packages.nix (shared with tools/build_own_cachix.py).
	# Uses the runner's upstream `predicate` argument so helpers/update.nix
	# needs no fork-specific parameter.
	exec nix-shell helpers/update.nix "${INPUT_ARGS[@]}" \
		--arg predicate '(attrPath: pkg: (import ./helpers/own-packages.nix { lib = (import <nixpkgs> { }).lib; }).isOwnPackage pkg)'
	;;
--path)
	[ $# -ge 2 ] || { echo "Usage: $0 --path <prefix>" >&2; exit 1; }
	shift
	exec nix-shell helpers/update.nix "${INPUT_ARGS[@]}" --argstr path "$*"
	;;
*)
	exec nix-shell helpers/update.nix "${INPUT_ARGS[@]}" --argstr packages "$*"
	;;
esac
