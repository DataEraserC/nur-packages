#!/bin/sh
# Launch Raccoon Work inside a private mount namespace.
#
# The app provisions its own CPython and Node builds at first launch. Those are
# generic Linux binaries whose interpreter is /lib64/ld-linux-x86-64.so.2; on
# NixOS that path is a stub that refuses to run them. Binding the real glibc
# loader over it here keeps the fix inside this app instead of changing the
# system-wide loader (programs.nix-ld) for every package.
set -eu

app="@app@"
appDir=$(dirname "$app")
loader="@loader@"
loaderDir="@loaderDir@"
loaderName="@loaderName@"
libPath="@libPath@"

# The app copies bundled resource trees into $HOME (fs.cp/fs.cpSync), which
# preserves the source modes, and Nix store files are read-only for everyone;
# so the copies come out 0444/0555 and the app then cannot rewrite its staged
# copies (it injects policy metadata into SKILL.md) nor remove them later:
# every startup aborts with EACCES on unlink. Bind writable-mode copies of
# every resource tree the app copies over the store originals, so its copies
# land user-writable as they do on a deb install. The stage is unique per
# launch, so concurrent instances never race; leftovers are bounded by the
# /tmp tmpfiles rules.
resourceStage=$(mktemp -d "${TMPDIR:-/tmp}/xiaohuanxiong-resources.XXXXXX")
resourceBinds=
for tree in conversation-skills hyperframes-assets; do
  if [ -d "$appDir/resources/$tree" ]; then
    cp -a "$appDir/resources/$tree" "$resourceStage/$tree"
    chmod -R u+w "$resourceStage/$tree"
    resourceBinds="$resourceBinds --ro-bind $resourceStage/$tree $appDir/resources/$tree"
  fi
done

runtimeArgs=
runtime="/run/user/$(id -u)"
if [ -d "$runtime" ]; then
  runtimeArgs="--bind $runtime $runtime"
fi

ozoneArgs=
if [ -n "${NIXOS_OZONE_WL:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
  ozoneArgs="--ozone-platform-hint=auto --enable-features=WaylandWindowDecorations --enable-wayland-ime=true --wayland-text-input-version=3"
fi

# shellcheck disable=SC2086
exec "@bwrap@" \
  --die-with-parent \
  --ro-bind / / \
  --dev-bind /dev /dev \
  --proc /proc \
  --bind /tmp /tmp \
  --bind "$HOME" "$HOME" \
  $runtimeArgs \
  $resourceBinds \
  --tmpfs "$loaderDir" \
  --ro-bind "$loader" "$loaderDir/$loaderName" \
  --chdir "$PWD" \
  --setenv LD_LIBRARY_PATH "$libPath${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
  -- "$app" --no-sandbox $ozoneArgs "$@"
