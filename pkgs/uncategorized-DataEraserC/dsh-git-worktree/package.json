{
  "name": "dsh-git-worktree",
  "version": "0.9.2",
  "description": "Experimental Git worktree Session Targets for DeepSeek Harness with isolated sessions, review checkpoints, human-confirmed delivery, and safe recovery.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/console-remote/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/console-remote/typert.d.ts",
      "default": "./lib/console-remote/typert.js"
    },
    "./remote": {
      "types": "./lib/console-remote/remote.d.ts",
      "default": "./lib/console-remote/remote.js"
    },
    "./console-contract": {
      "types": "./lib/console-contract.d.ts",
      "default": "./lib/console-contract.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "scripts",
    "CHANGELOG.md",
    "docs/i18n.md",
    "NOTICE",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wloops/dsh-git-worktree.git"
  },
  "bugs": {
    "url": "https://github.com/wloops/dsh-git-worktree/issues"
  },
  "homepage": "https://github.com/wloops/dsh-git-worktree#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "lucide-react": "1.43.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "^0.1.2-rc.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-fs": "^0.1.2-rc.1"
  }
}
