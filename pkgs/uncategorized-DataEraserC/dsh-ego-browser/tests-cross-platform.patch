-process.env.EGO_LOGIN_EXTENSION_PORT = '53920'
+// Every test drives its own loopback port. Sharing one fixed port made this
+// suite racy: stopLoginExtensionBridge() only calls server.close(), which
+// drops the listening socket and its keep-alive connections asynchronously, so
+// the next test listened on the same port while the previous server was still
+// tearing down - and undici, whose connection pool is keyed by origin
+// (host:port), still held an idle socket for that origin and reused it
+// (read ECONNRESET / TypeError: fetch failed under load).
+const allocated = new Set<number>()
+
+async function freshPort(): Promise<number> {
+  for (let attempt = 0; attempt < 50; attempt++) {
+    const port = await new Promise<number>((resolve, reject) => {
+      const probe = createServer()
+      probe.once('error', reject)
+      probe.listen(0, '127.0.0.1', () => {
+        const { port: assigned } = probe.address() as { port: number }
+        probe.close(() => resolve(assigned))
+      })
+    })
+    if (allocated.has(port)) continue
+    allocated.add(port)
+    return port
+  }
+  throw new Error('could not allocate a distinct loopback port')
+}
+
+// Point this test's bridge at its own port before anything starts a bridge.
+async function bridgePort(): Promise<number> {
+  const port = await freshPort()
+  process.env.EGO_LOGIN_EXTENSION_PORT = String(port)
+  return port
+}
+
+// stopLoginExtensionBridge() is fire-and-forget, so wait until the port can be
+// bound again instead of racing the next test's listen().
+async function stopBridge(port: number): Promise<void> {
+  stopLoginExtensionBridge()
+  for (let attempt = 0; attempt < 200; attempt++) {
+    const free = await new Promise<boolean>((resolve) => {
+      const probe = createServer()
+      probe.once('error', () => resolve(false))
+      probe.listen(port, '127.0.0.1', () => probe.close(() => resolve(true)))
+    })
+    if (free) return
+    await new Promise((r) => setTimeout(r, 10))
+  }
+}
 
