+func TestSpecACPExe(t *testing.T) {
+	setWrappers(t, map[string]Wrapper{"multi-instance": {Args: 2}})
+	r := NewRegistry(Spec{ACPArg: "--acp", ACPExe: "codebuddy-acp", ResumeFlag: "--resume"}.Agent("codebuddy"))
+	wrapped, err := r.Parse([]string{"multi-instance", "codebuddy", "1"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A wrapped command keeps its identity: the wrapper resolves the agent
+	// inside its own sandbox, so a shim cannot become an extra argument.
+	// Deployments that need one put it on the session PATH under the
+	// agent's name instead.
+	if argv, _ := wrapped.ACPArgv(); !reflect.DeepEqual(argv, []string{"multi-instance", "codebuddy", "1", "--acp"}) {
+		t.Fatalf("wrapped acp argv = %v", argv)
+	}
+	if got := wrapped.TUIArgv(); !reflect.DeepEqual(got, []string{"multi-instance", "codebuddy", "1"}) {
+		t.Fatalf("tui argv = %v", got)
+	}
+	direct, err := r.Parse([]string{"codebuddy"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if argv, _ := direct.ACPArgv(); !reflect.DeepEqual(argv, []string{"codebuddy-acp", "--acp"}) {
+		t.Fatalf("direct acp argv = %v", argv)
+	}
+	if argv, _ := direct.ResumeArgv("sid-1"); !reflect.DeepEqual(argv, []string{"codebuddy", "--resume", "sid-1"}) {
+		t.Fatalf("resume argv = %v", argv)
+	}
+}
