+func TestLoadWrappers(t *testing.T) {
+	t.Setenv(WrapperEnv, `{"multi-instance":{"args":2},"bad":{"args":-1},"with/slash":{"args":1},"huge":{"args":99},"one":{}}`)
+	got := loadWrappers()
+	want := map[string]Wrapper{"multi-instance": {Args: 2}, "one": {Args: 1}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("wrappers = %v, want %v", got, want)
+	}
+	t.Setenv(WrapperEnv, "not json")
+	if got := loadWrappers(); got != nil {
+		t.Fatalf("broken JSON returned %v", got)
+	}
+	t.Setenv(WrapperEnv, "")
+	if got := loadWrappers(); got != nil {
+		t.Fatalf("empty variable returned %v", got)
+	}
+}
