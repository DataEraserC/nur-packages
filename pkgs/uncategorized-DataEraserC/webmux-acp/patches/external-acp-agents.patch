diff --git a/internal/agentprofile/spec.go b/internal/agentprofile/spec.go
new file mode 100644
index 00000000..4936073c
--- /dev/null
+++ b/internal/agentprofile/spec.go
@@ -0,0 +1,129 @@
+package agentprofile
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"unicode/utf8"
+)
+
+// Spec describes an agent that has no built-in adapter. It carries only the
+// facts the ACP handshake cannot report: how to start the ACP server, how to
+// reopen a session in the terminal UI and how terminal processes are matched
+// to agent sessions. Everything else is negotiated at initialize time, so a
+// new CLI joins hybrid sessions with a Spec and no Go code.
+type Spec struct {
+	// Kind is the protocol family. Empty and "acp" both mean ACP.
+	Kind string `json:"kind,omitempty"`
+	// Title is the display name; empty falls back to the executable name.
+	Title string `json:"title,omitempty"`
+	// Icon is a launch-config icon key; empty falls back to "terminal".
+	Icon string `json:"icon,omitempty"`
+	// ACPArg starts the ACP server: a flag such as "--acp" or a subcommand
+	// such as "acp". Empty means the default "acp" subcommand.
+	ACPArg string `json:"acpArg,omitempty"`
+	// ACPExe runs the ACP server in place of the agent's executable, for
+	// CLIs whose ACP server has protocol gaps a stdio shim can fill: the
+	// shim receives the agent's kept arguments and ACPArg. It applies only
+	// to a direct run; a wrapped command keeps its identity and must be
+	// served the shim on the session PATH instead. Empty runs the agent
+	// itself.
+	ACPExe string `json:"acpExe,omitempty"`
+	// ResumeFlag opens a session in the terminal UI, followed by the session
+	// ID. Empty leaves the terminal side to session/load.
+	ResumeFlag string `json:"resumeFlag,omitempty"`
+	// Identity is how a terminal process is matched to an agent session.
+	// Empty and "none" both mean the match falls back to session/list.
+	Identity string `json:"identity,omitempty"`
+	// Launcher is the interpreter that runs as the PTY's root process when
+	// its direct child is the agent's native executable, such as "node" for
+	// an npm install. Empty means the executable runs the agent itself.
+	Launcher string `json:"launcher,omitempty"`
+}
+
+const (
+	// KindACP is the only protocol family a Spec can describe today.
+	KindACP = "acp"
+	// IdentityNone matches sessions through session/list instead of terminal
+	// signals. It is the only strategy, and the one agents without a session
+	// identity source need.
+	IdentityNone = "none"
+	// MaxSpecTitleChars bounds the display name like launch names are bound.
+	MaxSpecTitleChars = 64
+)
+
+// Validate reports whether s can build a profile.
+func (s Spec) Validate() error {
+	switch s.Kind {
+	case "", KindACP:
+	default:
+		return fmt.Errorf("unsupported kind %q", s.Kind)
+	}
+	switch s.Identity {
+	case "", IdentityNone:
+	default:
+		return fmt.Errorf("unsupported identity %q", s.Identity)
+	}
+	if strings.ContainsAny(s.ACPArg, " \t\n") || strings.ContainsAny(s.ResumeFlag, " \t\n") {
+		return errors.New("acpArg and resumeFlag must not contain whitespace")
+	}
+	if s.ACPExe != "" && strings.ContainsAny(s.ACPExe, "/\\ \t\n") {
+		return errors.New("acpExe must be a base name")
+	}
+	if s.Launcher != "" && strings.ContainsAny(s.Launcher, "/\\ \t\n") {
+		return errors.New("launcher must be a base name")
+	}
+	if !utf8.ValidString(s.Title) {
+		return errors.New("title is not valid UTF-8")
+	}
+	if utf8.RuneCountInString(s.Title) > MaxSpecTitleChars {
+		return fmt.Errorf("title exceeds %d characters", MaxSpecTitleChars)
+	}
+	return nil
+}
+
+// Agent builds the agent that runs as executable exe. The executable's base
+// name is both the agent name on the wire and the name the registry matches,
+// which is how built-in adapters identify their CLI too.
+func (s Spec) Agent(exe string) Agent {
+	name := filepath.Base(exe)
+	title := s.Title
+	if title == "" {
+		title = name
+	}
+	icon := s.Icon
+	if icon == "" {
+		icon = "terminal"
+	}
+	profile := Profile{
+		Name:        name,
+		Title:       title,
+		Icon:        icon,
+		Executables: []string{name},
+		Launcher:    s.Launcher,
+		ACPArg:      s.ACPArg,
+		ACPExe:      s.ACPExe,
+		ResumeFlag:  s.ResumeFlag,
+		Positional:  PositionalPrompt,
+		Options:     map[string]Option{},
+		Subcommands: SetOf(),
+	}
+	return &specAgent{profile: profile}
+}
+
+// specAgent is an agent whose behaviour comes entirely from its Spec. It has
+// no terminal-signal identity, so hybrid sessions match it by session/list.
+type specAgent struct{ profile Profile }
+
+// Profile implements Agent.
+func (a *specAgent) Profile() *Profile { return &a.profile }
+
+// Identify implements Agent. A spec agent reports no terminal identity: the
+// spec has no way to describe one, and a false result sends the caller to the
+// session/list fallback, which never writes to the agent's session store.
+func (a *specAgent) Identify(Signals) (Identity, bool) { return Identity{}, false }
+
+// InterruptKeys implements Agent with ctrl-c, which every terminal UI treats
+// as "stop the running turn".
+func (a *specAgent) InterruptKeys() [][]byte { return [][]byte{{0x03}} }
diff --git a/internal/agentprofile/wrapper.go b/internal/agentprofile/wrapper.go
new file mode 100644
index 00000000..c8110384
--- /dev/null
+++ b/internal/agentprofile/wrapper.go
@@ -0,0 +1,120 @@
+package agentprofile
+
+import (
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"os"
+	"strings"
+	"sync"
+)
+
+// WrapperEnv names the variable that declares wrapper executables. Its value
+// is a JSON object from wrapper executable base name to spec, for example:
+//
+//	{"multi-instance": {"args": 2}}
+//
+// A wrapper runs a registered agent behind a fixed leading argument list: the
+// first argument names the agent, Args-1 more pass through unchanged (an
+// instance or profile name), and everything after them is the agent's own
+// command line. WebMux keeps the leading list when it rebuilds the resume and
+// ACP commands, so the wrapped run and its chat side see the same state.
+const WrapperEnv = "WEBMUX_AGENT_WRAPPERS"
+
+// MaxWrapperArgs bounds how many leading arguments one wrapper may claim.
+const MaxWrapperArgs = 8
+
+// Wrapper is one declared wrapper executable.
+type Wrapper struct {
+	// Args is how many arguments follow the wrapper executable before the
+	// agent's own command line starts. The first names a registered agent;
+	// the rest pass through unchanged. It is at least 1.
+	Args int `json:"args"`
+	// Launcher is the wrapper's root process when it does not exec the
+	// agent itself, such as "bwrap" for a sandboxing wrapper: the PTY's
+	// root process is the launcher and the agent's executable is its direct
+	// child. Empty means the wrapper chain ends at the agent's executable.
+	Launcher string `json:"launcher,omitempty"`
+}
+
+// Validate reports whether w describes a wrapper.
+func (w Wrapper) Validate() error {
+	if w.Args < 1 {
+		return fmt.Errorf("args must be at least 1")
+	}
+	if w.Args > MaxWrapperArgs {
+		return fmt.Errorf("args exceeds %d", MaxWrapperArgs)
+	}
+	if w.Launcher != "" && strings.ContainsAny(w.Launcher, "/\\ \t\n") {
+		return fmt.Errorf("launcher must be a base name")
+	}
+	return nil
+}
+
+var (
+	// wrappersOnce is a pointer so tests can swap in a fresh once without
+	// copying a sync.Once value (which go vet's copylocks rejects).
+	wrappersOnce = new(sync.Once)
+	wrappers     map[string]Wrapper
+)
+
+// wrapperFor answers the wrapper declared for executable base name base.
+func wrapperFor(base string) (Wrapper, bool) {
+	wrappersOnce.Do(func() { wrappers = loadWrappers() })
+	w, ok := wrappers[base]
+	return w, ok
+}
+
+// launchAgent answers agent with the profile a wrapper's launcher needs:
+// the same profile with Launcher set, so a command run through the wrapper
+// recognises the launcher as its root process. Wrappers without a launcher
+// get the agent unchanged.
+func launchAgent(agent Agent, w Wrapper) Agent {
+	if w.Launcher == "" {
+		return agent
+	}
+	profile := *agent.Profile()
+	profile.Launcher = w.Launcher
+	return launchedAgent{Agent: agent, profile: &profile}
+}
+
+// launchedAgent is an agent that runs under a wrapper's launcher.
+type launchedAgent struct {
+	Agent
+	profile *Profile
+}
+
+// Profile implements Agent with the launcher-adjusted copy.
+func (a launchedAgent) Profile() *Profile { return a.profile }
+
+// loadWrappers reads WrapperEnv. Bad entries are logged and skipped: a typo
+// disables one wrapper instead of the whole server, and an empty variable
+// leaves every command parsed as before.
+func loadWrappers() map[string]Wrapper {
+	raw := strings.TrimSpace(os.Getenv(WrapperEnv))
+	if raw == "" {
+		return nil
+	}
+	var specs map[string]Wrapper
+	if err := json.Unmarshal([]byte(raw), &specs); err != nil {
+		slog.Warn("ignoring declared wrappers", "env", WrapperEnv, "err", err)
+		return nil
+	}
+	out := make(map[string]Wrapper, len(specs))
+	for name, spec := range specs {
+		if name == "" || strings.ContainsAny(name, "/\\ \t") {
+			slog.Warn("ignoring declared wrapper", "name", name, "err", "not an executable base name")
+			continue
+		}
+		if spec.Args == 0 {
+			// Omitted args means the wrapper takes only the agent name.
+			spec.Args = 1
+		}
+		if err := spec.Validate(); err != nil {
+			slog.Warn("ignoring declared wrapper", "name", name, "err", err)
+			continue
+		}
+		out[name] = spec
+	}
+	return out
+}
