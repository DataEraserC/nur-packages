+func TestParseWrapper(t *testing.T) {
+	setWrappers(t, map[string]Wrapper{"multi-instance": {Args: 2}})
+	r := specRegistry(t)
+	tests := []struct {
+		name   string
+		argv   []string
+		agent  string
+		reason Reason
+	}{
+		{name: "instance name", argv: []string{"multi-instance", "codebuddy", "1"}, agent: "codebuddy"},
+		{name: "named instance", argv: []string{"multi-instance", "codebuddy", "work"}, agent: "codebuddy"},
+		{name: "path to wrapper", argv: []string{"/usr/bin/multi-instance", "codebuddy", "home"}, agent: "codebuddy"},
+		{name: "startup form", argv: []string{"bash", "-ic", `exec -- "$@"`, "webmux", "multi-instance", "codebuddy", "1"}, agent: "codebuddy"},
+		{name: "agent args follow", argv: []string{"multi-instance", "codebuddy", "1", "--", "hello"}, agent: "codebuddy"},
+		{name: "missing identity arg", argv: []string{"multi-instance", "codebuddy"}, reason: ReasonUnsupportedForm},
+		{name: "unknown agent", argv: []string{"multi-instance", "trae", "1"}, reason: ReasonUnknownAgent},
+		{name: "direct still works", argv: []string{"codebuddy"}, agent: "codebuddy"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			support := r.Check(tt.argv)
+			if tt.agent != "" {
+				if !support.Supported || support.Agent != tt.agent {
+					t.Fatalf("support = %+v, want agent %q", support, tt.agent)
+				}
+				return
+			}
+			if support.Supported || support.Reason != tt.reason {
+				t.Fatalf("support = %+v, want reason %q", support, tt.reason)
+			}
+		})
+	}
+}
