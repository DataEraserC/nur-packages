+++ b/internal/agentprofile/wrapper_test.go
@@ -0,0 +1,267 @@
+package agentprofile
+
+import (
+	"reflect"
+	"sync"
+	"testing"
+)
+
+func TestSpecValidate(t *testing.T) {
+	tests := []struct {
+		name    string
+		spec    Spec
+		wantErr bool
+	}{
+		{name: "minimal", spec: Spec{}},
+		{name: "acp", spec: Spec{Kind: KindACP, Identity: IdentityNone}},
+		{name: "unknown kind", spec: Spec{Kind: "lsp"}, wantErr: true},
+		{name: "unknown identity", spec: Spec{Identity: "locks"}, wantErr: true},
+		{name: "acpArg with space", spec: Spec{ACPArg: "--acp stdio"}, wantErr: true},
+		{name: "resumeFlag with space", spec: Spec{ResumeFlag: "--resume now"}, wantErr: true},
+		{name: "acpExe with slash", spec: Spec{ACPExe: "/usr/bin/shim"}, wantErr: true},
+		{name: "acpExe with space", spec: Spec{ACPExe: "shim --acp"}, wantErr: true},
+		{name: "launcher with slash", spec: Spec{Launcher: "/usr/bin/node"}, wantErr: true},
+		{name: "long title", spec: Spec{Title: string(make([]byte, MaxSpecTitleChars+1))}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.spec.Validate()
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("Validate() error = %v, wantErr %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestSpecAgentProfile(t *testing.T) {
+	agent := Spec{Title: "CodeBuddy", Icon: "codebuddy", ACPArg: "--acp", ResumeFlag: "--resume", Launcher: "node"}.Agent("/usr/bin/codebuddy")
+	p := agent.Profile()
+	if p.Name != "codebuddy" {
+		t.Fatalf("agent name = %q, want codebuddy", p.Name)
+	}
+	if p.Title != "CodeBuddy" || p.Icon != "codebuddy" {
+		t.Fatalf("title/icon not kept: %q %q", p.Title, p.Icon)
+	}
+	if !reflect.DeepEqual(p.Executables, []string{"codebuddy"}) {
+		t.Fatalf("executables = %v", p.Executables)
+	}
+	if p.Launcher != "node" || p.ACPArg != "--acp" || p.ResumeFlag != "--resume" {
+		t.Fatalf("launcher/acpArg/resumeFlag not kept: %q %q %q", p.Launcher, p.ACPArg, p.ResumeFlag)
+	}
+	if _, ok := agent.Identify(Signals{}); ok {
+		t.Fatal("spec agent must not claim terminal identity")
+	}
+	if keys := agent.InterruptKeys(); len(keys) != 1 || keys[0][0] != 0x03 {
+		t.Fatalf("interrupt keys = %v", keys)
+	}
+	bare := Spec{}.Agent("myagent")
+	if bare.Profile().Title != "myagent" || bare.Profile().Icon != "terminal" {
+		t.Fatalf("defaults not applied: %+v", bare.Profile())
+	}
+}
