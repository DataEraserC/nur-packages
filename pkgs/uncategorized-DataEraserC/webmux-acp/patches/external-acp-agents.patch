@@ -0,0 +1,62 @@
+package agents
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/rainchan/webmux/internal/agentprofile"
+)
+
+func TestExternal(t *testing.T) {
+	t.Setenv(ExternalAgentsEnv, `{"codebuddy":{"title":"CodeBuddy","acpArg":"--acp","resumeFlag":"--resume"},"zcode":{"acpArg":"--acp","resumeFlag":"--resume","launcher":"node"}}`)
+	got := external()
+	if len(got) != 2 {
+		t.Fatalf("external() = %d agents, want 2", len(got))
+	}
+	if name := got[0].Profile().Name; name != "codebuddy" {
+		t.Fatalf("first agent = %q, want codebuddy (sorted)", name)
+	}
+	if p := got[1].Profile(); p.Name != "zcode" || p.Launcher != "node" {
+		t.Fatalf("second agent = %+v", p)
+	}
+}
+
+func TestExternalSkipsBadEntries(t *testing.T) {
+	t.Setenv(ExternalAgentsEnv, `{"opencode":{"acpArg":"--acp"},"bad name":{},"not/a/name":{},"broken":{"kind":"lsp"},"good":{}}`)
+	got := external()
+	if len(got) != 1 || got[0].Profile().Name != "good" {
+		names := make([]string, len(got))
+		for i, a := range got {
+			names[i] = a.Profile().Name
+		}
+		t.Fatalf("external() = %v, want [good] (built-in name, bad names and bad spec skipped)", names)
+	}
+}
+
+func TestExternalBrokenJSON(t *testing.T) {
+	t.Setenv(ExternalAgentsEnv, "not json")
+	if got := external(); got != nil {
+		t.Fatalf("external() = %v, want nil", got)
+	}
+}
+
+func TestExternalEmpty(t *testing.T) {
+	t.Setenv(ExternalAgentsEnv, "")
+	if got := external(); got != nil {
+		t.Fatalf("external() = %v, want nil", got)
+	}
+}
+
+// The declared agents join the built-in registry behind it in order.
+func TestExternalRegistry(t *testing.T) {
+	builtins := Default().Agents()
+	t.Setenv(ExternalAgentsEnv, `{"codebuddy":{"acpArg":"--acp","resumeFlag":"--resume"}}`)
+	extra := external()
+	combined := agentprofile.NewRegistry(append(builtins, extra...)...)
+	if _, ok := combined.Lookup("codebuddy"); !ok {
+		t.Fatal("declared agent missing from the combined registry")
+	}
+	if !reflect.DeepEqual(combined.Agents()[:len(builtins)], builtins) {
+		t.Fatal("built-in registry order changed")
+	}
+}
