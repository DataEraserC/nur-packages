+// setWrappers installs table for the test; Parse consults it through the
+// package's cached lookup.
+func setWrappers(t *testing.T, table map[string]Wrapper) {
+	t.Helper()
+	old, oldOnce := wrappers, wrappersOnce
+	wrappers = table
+	// Install a consumed once so the first lookup does not overwrite the
+	// table, and the cached lookup keeps using it for the rest of the test.
+	fresh := new(sync.Once)
+	fresh.Do(func() {})
+	wrappersOnce = fresh
+	t.Cleanup(func() { wrappers, wrappersOnce = old, oldOnce })
+}
