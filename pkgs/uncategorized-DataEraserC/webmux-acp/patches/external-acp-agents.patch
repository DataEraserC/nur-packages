+func TestWrapperValidate(t *testing.T) {
+	tests := []struct {
+		name    string
+		wrapper Wrapper
+		wantErr bool
+	}{
+		{name: "one arg", wrapper: Wrapper{Args: 1}},
+		{name: "two args", wrapper: Wrapper{Args: 2}},
+		{name: "zero args", wrapper: Wrapper{}, wantErr: true},
+		{name: "too many args", wrapper: Wrapper{Args: MaxWrapperArgs + 1}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.wrapper.Validate()
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("Validate() error = %v, wantErr %v", err, tt.wantErr)
+			}
+		})
+	}
+}
